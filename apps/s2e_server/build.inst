#!/bin/bash

set -e

MYPWD=`pwd`

. ${MYPWD}/../scripts/include/build.inst.inc

PROG=server
OUTPUT=install/bin/${PROG}

make clean > /dev/null
mkdir -p install/bin > /dev/null
make > /dev/null

mkdir -p /tmp/data > /dev/null

if [ $HAVE_LIBDFT -eq 1 ]; then
    ${LIBDFT}/utils/relink.py ${OUTPUT}  > /dev/null
fi

echo "Build completed successfully"